root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,swift}]
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

# Markdown gives trailing spaces a meaning, and the font license files carry them.
[*.{md,txt}]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
